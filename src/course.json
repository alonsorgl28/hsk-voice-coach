    {
      "id": "sc1-01",
      "number": 1,
      "status": "available",
      "version": 2,
      "title": {"hanzi": "你好", "pinyin": "Nǐ hǎo", "es": "Hola"},
      "objective": "Saludar a una persona, a alguien con respeto o a un grupo, y pedir perdón.",
      "book": {"printed": "2–7", "pdf": "22–27", "workbook": "impresa 1–4, PDF 3–6"},
      "goals": [
        {"id": "greet", "es": "Saludar y responder un saludo", "phrases": ["nihao"]},
        {"id": "greet-polite", "es": "Saludar con respeto o a un grupo", "phrases": ["ninhao", "nimenhao"]},
        {"id": "sorry", "es": "Pedir perdón", "phrases": ["duibuqi"]},
        {"id": "sorry-reply", "es": "Responder a una disculpa", "phrases": ["meiguanxi"]}
      ],
      "words": [
        {"hanzi": "你", "pinyin": "nǐ", "es": "tú"},
        {"hanzi": "好", "pinyin": "hǎo", "es": "bien; bueno"},
        {"hanzi": "您", "pinyin": "nín", "es": "usted"},
        {"hanzi": "你们", "pinyin": "nǐmen", "es": "ustedes"},
        {"hanzi": "对不起", "pinyin": "duìbuqǐ", "es": "perdón"},
        {"hanzi": "没关系", "pinyin": "méi guānxi", "es": "no pasa nada"}
      ],
      "phrases": [
        {"id": "nihao", "hanzi": "你好！", "pinyin": "Nǐ hǎo!", "es": "¡Hola!"},
        {"id": "ninhao", "hanzi": "您好！", "pinyin": "Nín hǎo!", "es": "¡Hola! (a usted, con respeto)"},
        {"id": "nimenhao", "hanzi": "你们好！", "pinyin": "Nǐmen hǎo!", "es": "¡Hola a todos!"},
        {"id": "duibuqi", "hanzi": "对不起！", "pinyin": "Duìbuqǐ!", "es": "¡Perdón!"},
        {"id": "meiguanxi", "hanzi": "没关系！", "pinyin": "Méi guānxi!", "es": "No pasa nada."}
      ],
      "steps": [
        {"id": "t-nihao", "kind": "teach", "title": "Escucha", "prompt": "Así se saludan dos personas. Escucha y repite en voz alta.", "lines": [{"who": "A", "phrase": "nihao"}, {"who": "B", "phrase": "nihao"}], "note": "Se responde con la misma frase. Al decirlo seguido, nǐ suena casi como ní.", "ref": "Texto 1, p. 2 (PDF 22)"},
        {"id": "r-nihao", "kind": "respond", "title": "Tu turno", "prompt": "La profesora te saluda. Respóndele.", "cue": "nihao", "answers": ["nihao", "ninhao"], "support": "nihao", "options": ["nihao", "duibuqi", "meiguanxi"], "ref": "Texto 1, p. 2 (PDF 22)"},
        {"id": "t-ninhao", "kind": "teach", "title": "Escucha", "prompt": "Dos personas saludan con respeto a alguien mayor, y él les responde a las dos.", "lines": [{"who": "A", "phrase": "ninhao"}, {"who": "B", "phrase": "nimenhao"}], "note": "您 (nín) es «usted». 你们 (nǐmen) es «ustedes»: le hablas a más de una persona.", "ref": "Texto 2, p. 2 (PDF 22)"},
        {"id": "u-nimenhao", "kind": "understand", "title": "¿Qué oíste?", "prompt": "Escucha. ¿A quién saluda?", "cue": "nimenhao", "choices": ["A varias personas", "A una persona mayor", "Pide perdón"], "answer": "A varias personas", "ref": "Texto 2, p. 2 (PDF 22)"},
        {"id": "r-ninhao", "kind": "respond", "title": "Tu turno", "prompt": "Entras a clase y saludas a tu profesora con respeto.", "answers": ["ninhao"], "support": "ninhao", "options": ["ninhao", "nimenhao", "meiguanxi"], "ref": "Texto 2, p. 2 (PDF 22)"},
        {"id": "t-duibuqi", "kind": "teach", "title": "Escucha", "prompt": "Alguien pide perdón y la otra persona le quita importancia.", "lines": [{"who": "A", "phrase": "duibuqi"}, {"who": "B", "phrase": "meiguanxi"}], "note": "对不起 sirve para «perdón» o «lo siento». 没关系 es «no pasa nada».", "ref": "Texto 3, p. 2 (PDF 22)"},
        {"id": "r-meiguanxi", "kind": "respond", "title": "Tu turno", "prompt": "La profesora te pide perdón. Dile que no pasa nada.", "cue": "duibuqi", "answers": ["meiguanxi"], "support": "meiguanxi", "options": ["meiguanxi", "nihao", "duibuqi"], "ref": "Texto 3, p. 2 (PDF 22)"},
        {"id": "c-meiguanxi", "kind": "recall", "title": "Sin mirar", "prompt": "Ahora alguien te pide perdón a ti. Respóndele.", "cue": "duibuqi", "answers": ["meiguanxi"], "support": "meiguanxi", "options": ["meiguanxi", "duibuqi", "nihao"], "ref": "Texto 3, p. 2 (PDF 22)"},
        {"id": "c-duibuqi", "kind": "recall", "title": "Sin mirar", "prompt": "Chocas sin querer con alguien. ¿Qué le dices?", "answers": ["duibuqi"], "support": "duibuqi", "options": ["duibuqi", "meiguanxi", "nihao"], "ref": "Texto 3, p. 2 (PDF 22)"},
        {"id": "c-nihao", "kind": "recall", "title": "Sin mirar", "prompt": "Te encuentras con una amiga. Salúdala.", "answers": ["nihao"], "support": "nihao", "options": ["nihao", "nimenhao", "duibuqi"], "ref": "Texto 1, p. 2 (PDF 22)"},
        {"id": "c-ninhao", "kind": "recall", "title": "Sin mirar", "prompt": "Saluda con respeto a una persona mayor.", "answers": ["ninhao"], "support": "ninhao", "options": ["ninhao", "nimenhao", "meiguanxi"], "ref": "Texto 2, p. 2 (PDF 22)"}
      ]
    },
    {
      "id": "sc1-02",
      "number": 2,
      "status": "available",
      "version": 2,
      "title": {"hanzi": "谢谢你", "pinyin": "Xièxie nǐ", "es": "Gracias"},
      "objective": "Dar las gracias, responder a un agradecimiento y despedirse.",
      "book": {"printed": "8–13", "pdf": "28–33", "workbook": "impresa 5–8, PDF 7–10"},
      "goals": [
        {"id": "thank", "es": "Dar las gracias", "phrases": ["xiexie", "xiexieni"]},
        {"id": "welcome", "es": "Responder a un agradecimiento", "phrases": ["buxie", "bukeqi"]},
        {"id": "bye", "es": "Despedirse", "phrases": ["zaijian"]}
      ],
      "words": [
        {"hanzi": "谢谢", "pinyin": "xièxie", "es": "gracias"},
        {"hanzi": "不", "pinyin": "bù", "es": "no"},
        {"hanzi": "不客气", "pinyin": "bú kèqi", "es": "de nada"},
        {"hanzi": "再见", "pinyin": "zàijiàn", "es": "adiós"}
      ],
      "phrases": [
        {"id": "xiexie", "hanzi": "谢谢！", "pinyin": "Xièxie!", "es": "¡Gracias!"},
        {"id": "buxie", "hanzi": "不谢！", "pinyin": "Bú xiè!", "es": "De nada."},
        {"id": "xiexieni", "hanzi": "谢谢你！", "pinyin": "Xièxie nǐ!", "es": "¡Gracias (a ti)!"},
        {"id": "bukeqi", "hanzi": "不客气！", "pinyin": "Bú kèqi!", "es": "No hay de qué."},
        {"id": "zaijian", "hanzi": "再见！", "pinyin": "Zàijiàn!", "es": "¡Adiós!"},
        {"id": "nihao", "hanzi": "你好！", "pinyin": "Nǐ hǎo!", "es": "¡Hola!", "listed": false, "from": "sc1-01"}
      ],
      "steps": [
        {"id": "t-xiexie", "kind": "teach", "title": "Escucha", "prompt": "Alguien da las gracias y la otra persona responde.", "lines": [{"who": "A", "phrase": "xiexie"}, {"who": "B", "phrase": "buxie"}], "note": "El segundo 谢 de xièxie se dice suave y corto. Delante de un cuarto tono, 不 suena bú.", "ref": "Texto 1, p. 8 (PDF 28)"},
        {"id": "r-buxie", "kind": "respond", "title": "Tu turno", "prompt": "La profesora te da las gracias. Respóndele.", "cue": "xiexie", "answers": ["buxie", "bukeqi"], "support": "buxie", "options": ["buxie", "xiexie", "zaijian"], "ref": "Texto 1, p. 8 (PDF 28)"},
        {"id": "t-bukeqi", "kind": "teach", "title": "Escucha", "prompt": "Otra forma de dar las gracias y de responder.", "lines": [{"who": "A", "phrase": "xiexieni"}, {"who": "B", "phrase": "bukeqi"}], "note": "不客气 es «no hay de qué». Sirve igual que 不谢.", "ref": "Texto 2, p. 8 (PDF 28)"},
        {"id": "u-bukeqi", "kind": "understand", "title": "¿Qué oíste?", "prompt": "Escucha. ¿Qué significa?", "cue": "bukeqi", "choices": ["No hay de qué", "Gracias", "Adiós"], "answer": "No hay de qué", "ref": "Texto 2, p. 8 (PDF 28)"},
        {"id": "t-zaijian", "kind": "teach", "title": "Escucha", "prompt": "Dos personas se despiden.", "lines": [{"who": "A", "phrase": "zaijian"}, {"who": "B", "phrase": "zaijian"}], "note": "Igual que con 你好, se responde con la misma frase.", "ref": "Texto 3, p. 8 (PDF 28)"},
        {"id": "r-zaijian", "kind": "respond", "title": "Tu turno", "prompt": "La profesora se despide. Despídete tú también.", "cue": "zaijian", "answers": ["zaijian"], "support": "zaijian", "options": ["zaijian", "nihao", "xiexie"], "ref": "Texto 3, p. 8 (PDF 28)"},
        {"id": "r-bukeqi", "kind": "respond", "title": "Conversa", "prompt": "Ahora te agradece de otra manera. Responde con la otra forma que aprendiste.", "cue": "xiexieni", "answers": ["bukeqi", "buxie"], "support": "bukeqi", "options": ["bukeqi", "duibuqi", "zaijian"], "ref": "Texto 2, p. 8 (PDF 28)"},
        {"id": "c-bukeqi", "kind": "recall", "title": "Sin mirar", "prompt": "Te dan las gracias. Respóndele.", "cue": "xiexieni", "answers": ["bukeqi", "buxie"], "support": "bukeqi", "options": ["bukeqi", "xiexie", "zaijian"], "ref": "Texto 2, p. 8 (PDF 28)"},
        {"id": "c-xiexie", "kind": "recall", "title": "Sin mirar", "prompt": "Alguien te ayuda con la maleta. Dale las gracias.", "answers": ["xiexie", "xiexieni"], "support": "xiexie", "options": ["xiexie", "buxie", "meiguanxi"], "ref": "Texto 1, p. 8 (PDF 28)"},
        {"id": "c-nihao2", "kind": "recall", "title": "Repaso", "prompt": "Llegas a clase y ves a una compañera. Salúdala.", "answers": ["nihao"], "support": "nihao", "options": ["nihao", "zaijian", "bukeqi"], "ref": "Lección 1, p. 2 (PDF 22)"},
        {"id": "c-zaijian", "kind": "recall", "title": "Sin mirar", "prompt": "Terminó la clase. Despídete.", "answers": ["zaijian"], "support": "zaijian", "options": ["zaijian", "xiexie", "nihao"], "ref": "Texto 3, p. 8 (PDF 28)"}
      ]
    },
