      "steps": [
        {"id": "t-nijiao", "kind": "teach", "title": "Escucha", "prompt": "Una persona pregunta el nombre y la otra contesta.", "lines": [{"who": "A", "phrase": "nijiao"}, {"who": "B", "phrase": "liyue"}], "note": "Para contestar, cambia Lǐ Yuè por tu nombre: Wǒ jiào + tu nombre.", "ref": "Texto 1, p. 14 (PDF 34)"},
