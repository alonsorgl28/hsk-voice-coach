        {"id": "c-zhongguo", "kind": "recall", "title": "Sin mirar", "prompt": "Te preguntan si eres chino. Contesta según tu caso.", "cue": "shizhongguorenma", "answers": ["bushizhongguoren", "meiguoren", "shizhongguoren"], "support": "bushizhongguoren", "options": ["bushizhongguoren", "shizhongguorenma", "shixuesheng"], "ref": "Texto 3, p. 15 (PDF 35)"},
